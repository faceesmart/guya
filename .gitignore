# Python / venv
venv/
**/__pycache__/
*.pyc
*.pyo

# Guya runtime data (per-user, never committed)
# config + logs live in ~/.guya, but ignore any local copies too
.guya/
*.log

# macOS junk
.DS_Store
**/.DS_Store

# IDE
.vscode/
.idea/
*.swp
*~

# Model cache (lives in ~/.cache/huggingface)
*.bin
models/

# Generated double-click launchers (machine-specific paths)
Start Guya.command
Start Guya.bat

# Generated launchers (per-machine)
Start Guya.vbs
Guya.app/

# Eval audio is regenerable/large; manifests and result tables ARE committed
eval/data/*
!eval/data/fleurs/
eval/data/fleurs/*
!eval/data/fleurs/manifest.jsonl
!eval/data/say_manifest.jsonl
!eval/data/intents.jsonl

# report build tooling
docs/tools/node_modules/
docs/*.print.html

# proprietary academic fonts used only for the PDF build (B Nazanin, B Titr)
docs/tools/assets/fonts/
